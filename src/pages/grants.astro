---
import Base from "../layouts/Base.astro";
import Grant from "../components/Grant.astro";
import SponsorSummary from "../components/SponsorSummary.astro";
import { GRANTS } from "../lib/data";
---
<Base title="Grants" description="Grants that fund NEU HAI's research, from NIH, NSF, Microsoft Research, and Northeastern University." page="grants">
<section class="page-head night">
  <div class="wrap">
    <h1>Grants</h1>
    <p>Our work is funded by federal, industry, and university grants. These are the projects they support.</p>
    <p class="readout" id="grant-sum" style="margin-top:22px"><b>{GRANTS.length}</b> funded grants <span class="sep">/</span> <SponsorSummary /></p>
  </div>
</section>
<section class="wrap" style="padding-bottom:96px">
  <h2 class="subhead">External grants</h2>
  <ul class="grant-list" id="grants-ext">{GRANTS.filter((g) => !g.internal).map((g) => <Grant grant={g} />)}</ul>
  <h2 class="subhead" style="margin-top:64px">Internal and partner grants</h2>
  <ul class="grant-list" id="grants-int">{GRANTS.filter((g) => g.internal).map((g) => <Grant grant={g} />)}</ul>
</section>
</Base>
