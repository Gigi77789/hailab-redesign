---
import Base from "../layouts/Base.astro";
import Person from "../components/Person.astro";
import { DIRECTOR as pi, MEMBERS } from "../lib/data";
const group = (g: string) => MEMBERS.filter((m) => m.group === g);
const faculty = [{ name: pi.name, role: pi.role, photo: pi.photo, url: pi.url, bio: pi.short }, ...group("faculty")];
---
<Base title="Lab members" description="The members of NEU HAI, Northeastern University's Human-Centered AI Lab: faculty, research scientists, PhD students, visitors, and alumni." page="people">
<section class="page-head">
  <div class="wrap"><h1>Lab members</h1></div>
</section>
<section class="wrap members">
  <div class="group">
    <h2 class="subhead">Faculty and research scientists</h2>
    <ul class="people-grid" id="faculty">{faculty.map((m) => <Person person={m} />)}</ul>
  </div>
  <div class="group">
    <h2 class="subhead">PhD students</h2>
    <ul class="people-grid" id="phd">{group("phd").map((m) => <Person person={m} />)}</ul>
  </div>
  <div class="group">
    <h2 class="subhead">Research assistants</h2>
    <ul class="people-grid" id="ra">{group("ra").map((m) => <Person person={m} />)}</ul>
  </div>
  <div class="group">
    <h2 class="subhead">Visiting students</h2>
    <ul class="people-grid" id="visiting">{group("visiting").map((m) => <Person person={m} />)}</ul>
  </div>
  <div class="group">
    <h2 class="subhead">Alumni</h2>
    <ul class="alumni" id="alumni">{group("alumni").map((m) => <li>{m.url ? <a class="n" href={m.url}>{m.name}</a> : <span class="n">{m.name}</span>}<span class="r">{m.role}</span></li>)}</ul>
  </div>
</section>
</Base>
