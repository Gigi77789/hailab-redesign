---
import Base from "../layouts/Base.astro";
import { NEWS, fmtMonth } from "../lib/data";
---
<Base title="News" description="News from NEU HAI: accepted papers, talks, visitors, and grants." page="news">
<section class="page-head">
  <div class="wrap"><h1>News</h1></div>
</section>
<section class="wrap" style="padding-bottom:96px">
  <ol class="news-list" id="news">{NEWS.map((n) => <li><time datetime={n.date}>{fmtMonth(n.date)}</time><div set:html={n.html} /></li>)}</ol>
</section>
</Base>
