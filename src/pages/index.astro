---
import Base from "../layouts/Base.astro";
import Tag from "../components/Tag.astro";
import Face from "../components/Face.astro";
import { AREAS, CATEGORIES, DIRECTOR, MEMBERS, NEWS, PAPERS, fmtMonth, mainTopic, url } from "../lib/data";

// the publication chart draws one dot per paper in the browser
const field = {
  cats: CATEGORIES,
  papers: PAPERS.map((p) => ({ t: p.title, y: p.year, tag: p.tag, topics: p.topics, href: p.href })),
};
// lab members on the home page: faculty, PhD students and research assistants; visiting students are not
const faces = [{ name: DIRECTOR.name, role: "Lab director", photo: DIRECTOR.photo, url: DIRECTOR.url },
  ...MEMBERS.filter((m) => m.group === "faculty" || m.group === "phd" || m.group === "ra")];
const shortAuthors = (a: string[]) => (a.length > 6 ? a.slice(0, 6).join(", ") + ", et al." : a.join(", "));
---
<Base description="NEU HAI is the Human-Centered AI Lab at Northeastern University, led by Prof. Dakuo Wang. We study how people and AI work together, and design AI systems that collaborate with people in health care, education, and data science." page="home">
<h1 class="visually-hidden">NEU HAI, the Human-Centered AI Lab at Northeastern University</h1>
<section class="intro" aria-label="About the lab">
  <canvas class="mesh" id="mesh" aria-hidden="true"></canvas>
  <div class="wrap">
    <p class="intro-lead"><span class="l1">Designing AI systems and interactions</span> <span class="l2">that work effectively for and with people.</span></p>
  </div>
</section>

<section class="overview" aria-label="Publications and news">
  <div class="wrap overview-grid">
    <div>
      <div class="block-head">
        <h2 id="pubs-h">Publications</h2>
        <a class="more" href={url("publications")}>All publications</a>
      </div>
      <figure class="field" id="field" aria-labelledby="pubs-h">
        <div class="field-keys" id="legend" role="group" aria-label="Highlight a research area">
          {CATEGORIES.map((c) => <button type="button" class={`fk k-${c.key}`} data-topic={c.key} aria-pressed="false"><span class="key"></span>{c.name}</button>)}
        </div>
        <div class="field-plot" id="field-plot" role="img" aria-label="Dot chart of the lab’s publications by year, one dot per paper, colored by main research area."></div>
        <div class="tip" id="tip" role="status"></div>
      </figure>
      <script is:inline type="application/json" id="field-data" set:html={JSON.stringify(field).replace(/</g, "\\u003c")} />
    </div>
    <aside class="latest" aria-labelledby="latest-h">
      <div class="block-head">
        <h2 id="latest-h">Latest news</h2>
        <a class="more" href={url("news")}>All news</a>
      </div>
      <ol class="news-scroll" id="latest" tabindex="0" aria-label="All news, newest first">{NEWS.map((n) => <li><time datetime={n.date}>{fmtMonth(n.date)}</time><Fragment set:html={n.html} /></li>)}</ol>
    </aside>
  </div>
</section>

<section class="section band" aria-labelledby="research-h">
  <div class="wrap">
    <div class="block-head"><h2 id="research-h">Research areas</h2></div>
    <div class="explorer" id="explorer">
      <div class="ex-list" role="tablist" aria-label="Research areas"><span class={`ex-ind k-${AREAS[0].topic}`} aria-hidden="true"></span>{AREAS.map((a, i) => (
        <button class={`ex-item k-${a.topic}`} role="tab" id={`ex-t-${a.topic}`} aria-controls={`ex-p-${a.topic}`} aria-selected={String(i === 0)} tabindex={i === 0 ? 0 : -1}>
          <span class="ex-no" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span class="ex-text"><span class="ex-name">{a.name}</span><span class="ex-short">{a.summary}</span></span>
        </button>))}</div>
      <div class="ex-stage">{AREAS.map((a, i) => (
        <div class="ex-panel" role="tabpanel" id={`ex-p-${a.topic}`} aria-labelledby={`ex-t-${a.topic}`} hidden={i > 0}>
          <ol class="ex-papers" aria-label={`Newest papers in ${a.name}`}>{PAPERS.filter((p) => mainTopic(p) === a.topic).slice(0, 4).map((p, j) => (
            <li class={j === 0 ? "on" : undefined}>
              <div class="ex-open ex-fig"><div>{p.img && <a class="screen" href={p.href} tabindex="-1"><img src={url(p.img)} alt={`Figure from “${p.title}”`} loading="lazy"></a>}</div></div>
              <button type="button" class="ex-paper" aria-expanded={String(j === 0)}>
                <span class="ex-paper-title">{p.title}</span>
                <span class="ex-paper-meta"><Tag paper={p} />{!/\d{4}/.test(p.tag) && ` ${p.year}`}</span>
                <span class="ex-authors">{shortAuthors(p.authors)}</span>
              </button>
              <div class="ex-open"><div><p class="pub-links ex-row-links">{p.links.length ? p.links.map((l) => <a href={l.url}>{l.label}</a>) : <a href={p.href}>Find the paper</a>}</p></div></div>
            </li>))}</ol>
          <a class="more" href={url(`publications#${a.topic}`)}>All papers in {a.name}</a>
        </div>))}</div>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="people-h">
  <div class="wrap">
    <div class="block-head">
      <h2 id="people-h">Lab members</h2>
      <a class="more" href={url("people")}>Visitors and alumni</a>
    </div>
    <ul class="faces home" id="faces">{faces.map((m) => <Face person={m} />)}</ul>
  </div>
</section>

<section class="section join" aria-labelledby="join-h">
  <div class="wrap join-band">
    <div>
      <h2 id="join-h">Work with us</h2>
      <p>We take PhD students, postdocs, visiting scholars, and research interns who want to build AI for health care, education, or agents, and test it with real people.</p>
    </div>
    <a class="btn" href={url("join")}>Join us</a>
  </div>
</section>
</Base>
